# /etc/courtshot/server.env, read by courtshot.service. Readable by root and the service user only.
COURTSHOT_DATA_DIR=/var/lib/courtshot
COURTSHOT_PUBLIC_ORIGIN=https://courtshot.example.org
COURTSHOT_TRUSTED_PROXY=127.0.0.1
COURTSHOT_SECURE_COOKIES=true
# Defaults, shown for reference:
# COURTSHOT_MIN_VIDEO_SECONDS=10
# COURTSHOT_MAX_VIDEO_SECONDS=900
# COURTSHOT_MAX_UPLOAD_BYTES=8589934592
# COURTSHOT_CHUNK_BYTES=8388608
# COURTSHOT_MAX_CHUNK_BYTES=16777216
# COURTSHOT_CALIBRATION_MAX_ERROR_M=0.25
# COURTSHOT_MIN_CALIBRATION_POINTS=6
# COURTSHOT_LEASE_SECONDS=90
# COURTSHOT_MAX_ATTEMPTS=3
# COURTSHOT_RETRY_DELAY_SECONDS=60
# COURTSHOT_HEARTBEAT_SECONDS=15
# COURTSHOT_WORKER_ONLINE_SECONDS=30
# COURTSHOT_FREE_SPACE_RESERVE_BYTES=5368709120
# COURTSHOT_INCOMPLETE_UPLOAD_DAYS=7
# COURTSHOT_WEB_DIST=/opt/courtshot/server/web/dist
